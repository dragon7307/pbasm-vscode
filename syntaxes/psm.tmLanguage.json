{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "PicoBlaze Assembly",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#registers"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#flags"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#mnemonics"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.semicolon.psm",
                    "match": ";.*$\\n?"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "~?\\b((0x)?[0-9A-Fa-f]{1,2}|\\d{1,3}'d|[01]{1,8}'b)\\b",
                    "captures": {
                        "1": {
                            "name": "constant.numeric.psm"
                        }
                    }
                }
            ]
        },
        "registers": {
            "patterns": [
                {
                    "name": "support.type.register.psm",
                    "match": "\\b([sS][0-9A-Fa-f])\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.psm",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.psm",
                    "match": "\\\\."
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*):",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.psm"
                        }
                    }
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "entity.name.function.psm",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
                }
            ]
        },
        "flags": {
            "patterns": [
                {
                    "name": "variable.parameter.psm",
                    "match": "\\b(Z|NZ|C|NC)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.psm",
                    "match": "\\b(?:NUL|BEL|BS|HT|LF|VT|CR|ESC|DEL|DCS|ST)\\b"
                }
            ]
        },
        "mnemonics": {
            "patterns": [
                {
                    "match": "^\\s*(([a-zA-Z_][a-zA-Z0-9_]*):\\s*)*([a-zA-Z]+\\d?)",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.psm"
                        },
                        "3": {
                            "name": "keyword.other.mnemonic.psm"
                        }
                    }
                }
            ]
        }
    },
    "scopeName": "source.psm"
}