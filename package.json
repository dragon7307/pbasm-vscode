{
  "name": "picoblaze-assembly",
  "displayName": "PicoBlaze Assembly 3 & 6",
  "description": "Language Support for PicoBlaze 3 & 6 Assembly",
  "version": "1.0.0",
  "repository": "https://github.com/dragon7307/pbasm-vscode",
  "publisher": "draconware",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "psm",
      "aliases": ["PicoBlaze Assembly", "pbasm"],
      "extensions": [".psm"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "psm",
      "scopeName": "source.psm",
      "path": "./syntaxes/psm.tmLanguage.json"
    }]
  }
}